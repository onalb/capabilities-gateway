# Optional local overrides. Do not commit secrets.
PORT=8010
# One Lambda for every POST /mcp/deal and POST /mcp/vacancy tool, including
# checklist tools. Handler: capabilities_gateway.tools_lambda.handler
# Event: {"tool": "<name>", "arguments": {...}} plus "route" for checklist.
# Unset (or blank) calls that handler in this process. Local docker and pytest
# leave it unset and do not need an AWS account. Not used for GET /skills, and
# not used for score_gcr (that Lambda belongs to the deal app).
# TOOLS_LAMBDA_ARN=
# Local vacancy app (uvicorn --port 8000). From inside this container the host is host.docker.internal.
# Public override: https://vacancy-agent.purplegrass-79f82a02.eastus.azurecontainerapps.io/mcp
VACANCY_MCP_URL=http://host.docker.internal:8000/mcp
# DDB_ENDPOINT=http://127.0.0.1:8003
# DDB_TABLE=ml_interview
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=fits
# VACANCY_FIT_DIR=data/fits
